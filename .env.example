# Supabase (optional — guest mode works without these)
# Create a project at https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Production ---
# These must be set on your HOST (Vercel, Netlify, Cloudflare Pages, etc.) as environment
# variables used during `npm run build`. Vite replaces import.meta.env.VITE_* at compile time;
# adding vars only at “runtime” on the server, or only in your local .env, will NOT fix the
# live site until you redeploy a new build that sees them.

# Public site URL (share links + fallbacks when the card “link” field is empty)
# Example: https://moodscreen.live
# VITE_PUBLIC_SITE_URL=https://moodscreen.live

# In Supabase Dashboard → Authentication → URL configuration:
#   Site URL: http://localhost:5173
#   Redirect URLs: http://localhost:5173/**  (and your production URL)
